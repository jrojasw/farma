@model Product

<div class="product-card">
    <a asp-controller="Products" asp-action="Details" asp-route-slug="@Model.Slug" class="product-img-wrap d-block">
        @if (Model.IsFeatured)
        {
            <span class="badge badge-featured featured-ribbon"><i class="bi bi-star-fill"></i> Destacado</span>
        }
        <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://placehold.co/400x300?text=Farmacia+Salud" : Model.ImageUrl)" alt="@Model.Name" loading="lazy" />
    </a>
    <div class="card-body p-3">
        @if (Model.Category is not null)
        {
            <div class="small text-muted mb-1">@Model.Category.Name</div>
        }
        <h3 class="h6 mb-2">
            <a asp-controller="Products" asp-action="Details" asp-route-slug="@Model.Slug" class="text-dark text-decoration-none">@Model.Name</a>
        </h3>
        <div class="mb-2">
            @if (Model.RequiresPrescription)
            {
                <span class="badge badge-rx"><i class="bi bi-file-earmark-medical"></i> Requiere receta</span>
            }
            @if (!Model.InStock)
            {
                <span class="badge badge-stock-out">Agotado</span>
            }
        </div>
        <div class="mt-auto d-flex align-items-center justify-content-between">
            <span class="product-price">$@Model.Price.ToString("0.00")</span>
            <form asp-controller="Cart" asp-action="Add" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.Id" />
                <input type="hidden" name="quantity" value="1" />
                <button type="submit" class="btn btn-sm btn-brand" @(Model.InStock ? "" : "disabled")>
                    <i class="bi bi-cart-plus"></i>
                </button>
            </form>
        </div>
    </div>
</div>
