@using Farmacia.Web.Data
@using Farmacia.Web.Services
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject CartService Cart
@{
    var navCategories = await Db.Categories.OrderBy(c => c.Name).ToListAsync();
    var cartCount = Cart.GetItemCount();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Farmacias Rosita</title>
    <link rel="icon" type="image/svg+xml" href="~/img/favicon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="topbar py-1">
            <div class="container d-flex flex-wrap justify-content-between align-items-center">
                <div class="d-flex gap-3">
                    <span><i class="bi bi-telephone-fill"></i> (555) 123-4567</span>
                    <span class="d-none d-md-inline"><i class="bi bi-clock-fill"></i> Lun–Sáb 7:00–22:00</span>
                </div>
                <div class="d-flex gap-3">
                    @if (User.Identity is not null && User.Identity.IsAuthenticated)
                    {
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Panel</a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-link btn-sm p-0 align-baseline" style="color:#fbe4f0;">Cerrar sesión</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login"><i class="bi bi-shield-lock-fill"></i> Acceso staff</a>
                    }
                </div>
            </div>
        </div>
        <nav class="navbar navbar-expand-lg main-navbar py-2">
            <div class="container">
                <a class="navbar-brand navbar-brand-farmacia" asp-controller="Home" asp-action="Index">
                    <span class="brand-cross">
                        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <rect x="10" y="32" width="80" height="36" rx="10" fill="currentColor" />
                            <rect x="32" y="10" width="36" height="80" rx="10" fill="currentColor" />
                        </svg>
                    </span>
                    <span class="brand-lockup">
                        <span class="brand-eyebrow">Farmacias</span>
                        <span class="brand-word">Rosita</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Alternar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Productos
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Index">Todos los productos</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                @foreach (var cat in navCategories)
                                {
                                    <li><a class="dropdown-item" asp-controller="Products" asp-action="Index" asp-route-category="@cat.Slug">@cat.Name</a></li>
                                }
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="ubicacion">Ubicación</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contact" asp-action="Index">Contacto</a>
                        </li>
                    </ul>
                    <form class="d-flex me-3 my-2 my-lg-0" asp-controller="Products" asp-action="Index" method="get" role="search">
                        <input class="form-control form-control-sm" type="search" name="q" placeholder="Buscar productos..." aria-label="Buscar" />
                    </form>
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-brand btn-sm position-relative">
                        <i class="bi bi-cart3"></i> Carrito
                        @if (cartCount > 0)
                        {
                            <span class="position-absolute cart-badge badge rounded-pill">@cartCount</span>
                        }
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer pt-5 pb-4">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h6><i class="bi bi-plus-lg"></i> Farmacias Rosita</h6>
                    <p class="small mb-2">Tu farmacia de confianza. Medicamentos, cuidado personal y equipo médico con atención profesional y entrega a domicilio.</p>
                </div>
                <div class="col-lg-2 col-6">
                    <h6>Enlaces</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li><a asp-controller="Products" asp-action="Index">Productos</a></li>
                        <li><a asp-controller="Contact" asp-action="Index">Contacto</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-6">
                    <h6>Categorías</h6>
                    <ul class="list-unstyled small">
                        @foreach (var cat in navCategories.Take(5))
                        {
                            <li><a asp-controller="Products" asp-action="Index" asp-route-category="@cat.Slug">@cat.Name</a></li>
                        }
                    </ul>
                </div>
                <div class="col-lg-3" id="ubicacion">
                    <h6>Contacto</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-1"><i class="bi bi-geo-alt-fill"></i> Av. Principal 123, Ciudad</li>
                        <li class="mb-1"><i class="bi bi-telephone-fill"></i> (555) 123-4567</li>
                        <li class="mb-1"><i class="bi bi-envelope-fill"></i> contacto@farmaciasrosita.cl</li>
                        <li class="mb-1"><i class="bi bi-clock-fill"></i> Lun–Sáb 7:00–22:00, Dom 8:00–20:00</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="footer-bottom text-center py-3 mt-4">
            &copy; @DateTime.Now.Year Farmacias Rosita. Todos los derechos reservados.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
