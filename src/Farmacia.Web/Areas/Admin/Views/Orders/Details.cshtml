@model Order
@{
    ViewData["Title"] = $"Pedido #{Model.Id:D5}";
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="border rounded-4 p-4 mb-4">
            <h2 class="h6 mb-3">Productos</h2>
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th class="text-center">Cantidad</th>
                        <th class="text-end">Precio unitario</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">$@item.UnitPrice.ToString("0.00")</td>
                            <td class="text-end">$@item.Subtotal.ToString("0.00")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end fw-bold">Total</td>
                        <td class="text-end fw-bold">$@Model.Total.ToString("0.00")</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="border rounded-4 p-4">
                <h2 class="h6 mb-2">Notas del cliente</h2>
                <p class="mb-0 small">@Model.Notes</p>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="border rounded-4 p-4 mb-4">
            <h2 class="h6 mb-3">Cliente</h2>
            <p class="small mb-1"><strong>@Model.CustomerName</strong></p>
            <p class="small mb-1"><i class="bi bi-envelope"></i> @Model.CustomerEmail</p>
            <p class="small mb-1"><i class="bi bi-telephone"></i> @Model.CustomerPhone</p>
            <p class="small mb-0"><i class="bi bi-geo-alt"></i> @Model.Address</p>
        </div>

        <div class="border rounded-4 p-4">
            <h2 class="h6 mb-3">Estado del pedido</h2>
            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <select name="status" class="form-select mb-3">
                    @foreach (var status in Enum.GetValues<OrderStatus>())
                    {
                        <option value="@status" selected="@(status == Model.Status)">@status</option>
                    }
                </select>
                <button type="submit" class="btn btn-brand w-100">Actualizar estado</button>
            </form>
        </div>
    </div>
</div>
