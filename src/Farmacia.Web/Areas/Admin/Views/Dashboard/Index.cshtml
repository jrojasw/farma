@model List<Order>
@{
    ViewData["Title"] = "Panel de control";
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="border rounded-4 p-3">
            <div class="text-muted small">Productos</div>
            <div class="fs-3 fw-bold">@ViewData["ProductCount"]</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="border rounded-4 p-3">
            <div class="text-muted small">Pedidos totales</div>
            <div class="fs-3 fw-bold">@ViewData["OrderCount"]</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="border rounded-4 p-3">
            <div class="text-muted small">Pedidos pendientes</div>
            <div class="fs-3 fw-bold text-warning">@ViewData["PendingOrderCount"]</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="border rounded-4 p-3">
            <div class="text-muted small">Mensajes sin leer</div>
            <div class="fs-3 fw-bold text-danger">@ViewData["UnreadMessageCount"]</div>
        </div>
    </div>
</div>

<div class="border rounded-4 p-3 mb-4">
    <div class="text-muted small">Ingresos totales (pedidos no cancelados)</div>
    <div class="fs-2 fw-bold" style="color:var(--brand-primary-dark);">$@(((decimal)ViewData["Revenue"]!).ToString("0.00"))</div>
</div>

<div class="border rounded-4 p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h6 mb-0">Pedidos recientes</h2>
        <a asp-controller="Orders" asp-action="Index" class="small">Ver todos</a>
    </div>
    @if (!Model.Any())
    {
        <p class="text-muted small mb-0">Aún no hay pedidos.</p>
    }
    else
    {
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>#@order.Id.ToString("D5")</td>
                        <td>@order.CustomerName</td>
                        <td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>$@order.Total.ToString("0.00")</td>
                        <td><span class="badge bg-secondary-subtle text-secondary-emphasis">@order.Status</span></td>
                        <td><a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="small">Ver</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
