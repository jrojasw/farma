@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Panel Admin | Farmacias Rosita</title>
    <link rel="icon" type="image/svg+xml" href="~/img/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex">
        <nav class="admin-sidebar p-3" style="width:240px;flex-shrink:0;">
            <a class="navbar-brand-farmacia text-decoration-none mb-4" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-cross"><i class="bi bi-plus-lg"></i></span>
                <span class="brand-lockup">
                    <span class="brand-eyebrow" style="color:#f0d5e6;">Farmacias</span>
                    <span class="brand-word" style="color:#ffffff;font-size:1.2rem;">Rosita</span>
                </span>
            </a>
            <ul class="nav nav-pills flex-column gap-1">
                <li class="nav-item">
                    <a class="nav-link rounded-3 @(currentController == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Panel
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link rounded-3 @(currentController == "Products" ? "active" : "")" asp-area="Admin" asp-controller="Products" asp-action="Index">
                        <i class="bi bi-capsule"></i> Productos
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link rounded-3 @(currentController == "Categories" ? "active" : "")" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                        <i class="bi bi-tags"></i> Categorías
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link rounded-3 @(currentController == "Orders" ? "active" : "")" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                        <i class="bi bi-bag-check"></i> Pedidos
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link rounded-3 @(currentController == "Messages" ? "active" : "")" asp-area="Admin" asp-controller="Messages" asp-action="Index">
                        <i class="bi bi-envelope"></i> Mensajes
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link rounded-3 @(currentController == "Subscribers" ? "active" : "")" asp-area="Admin" asp-controller="Subscribers" asp-action="Index">
                        <i class="bi bi-envelope-paper"></i> Suscriptores
                    </a>
                </li>
            </ul>
            <hr class="border-secondary" />
            <ul class="nav flex-column gap-1">
                <li class="nav-item">
                    <a class="nav-link rounded-3 @(currentController == "Account" ? "active" : "")" asp-controller="Account" asp-action="ChangePassword">
                        <i class="bi bi-key"></i> Cambiar contraseña
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link rounded-3" asp-controller="Home" asp-action="Index" asp-area="">
                        <i class="bi bi-box-arrow-up-right"></i> Ver sitio
                    </a>
                </li>
                <li class="nav-item">
                    <form asp-controller="Account" asp-action="Logout" asp-area="" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link nav-link rounded-3 text-start w-100 p-2">
                            <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                        </button>
                    </form>
                </li>
            </ul>
        </nav>

        <main class="flex-fill">
            <div class="bg-white border-bottom px-4 py-3">
                <h1 class="h5 mb-0">@ViewData["Title"]</h1>
            </div>
            <div class="p-4">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success">@success</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger">@error</div>
                }
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
